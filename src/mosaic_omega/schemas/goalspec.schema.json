{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic-omega.local/schemas/goalspec.schema.json",
  "title": "MOSAIC-Ω GoalSpec",
  "type": "object",
  "required": [
    "main_goal",
    "hard_constraints",
    "soft_preferences",
    "acceptance_conditions",
    "budget",
    "prohibitions"
  ],
  "additionalProperties": false,
  "properties": {
    "main_goal": {
      "type": "object",
      "required": ["goal_text", "goal_type", "domain", "sub_goals", "confidence"],
      "properties": {
        "goal_text": {"type": "string", "minLength": 1},
        "goal_type": {
          "type": "string",
          "enum": ["research", "coding", "planning", "robot_task", "analysis", "report_generation", "other"]
        },
        "domain": {"type": "string"},
        "sub_goals": {"type": "array"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint", "type", "checkable", "check_method", "predicate", "source_span", "confidence"],
        "properties": {
          "constraint": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "checkable": {"type": "boolean"},
          "check_method": {"type": "string"},
          "predicate": {"type": "string"},
          "source_span": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "soft_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["preference", "priority", "weight"],
        "properties": {
          "preference": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1, "maximum": 5},
          "weight": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "acceptance_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "predicate", "check_type", "expected_result", "confidence"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "predicate": {"type": "string"},
          "check_type": {
            "type": "string",
            "enum": ["manual_review", "schema_check", "file_check", "content_check", "unit_test", "simulation_check", "metric_check"]
          },
          "expected_result": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "budget": {
      "type": "object",
      "required": ["time_limit", "token_limit", "compute_limit", "cost_limit"],
      "properties": {
        "time_limit": {"type": ["string", "null"]},
        "token_limit": {"type": ["integer", "null"], "minimum": 0},
        "compute_limit": {"type": ["string", "null"]},
        "cost_limit": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "type", "reason", "confidence"],
        "properties": {
          "rule": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "reason": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    }
  }
}
